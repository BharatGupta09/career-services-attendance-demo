# Variables read by the database scripts (db:migrate, db:seed-demo,
# db:set-credentials, validate). Set them in your shell for one command;
# do not commit a filled-in copy (.env files are git-ignored).
#
# Required explicit opt-in: the scripts refuse to run without it.
DEMO_MODE=
# Connection string of a database created for the demo. Scripts never read
# DATABASE_URL. Leave empty to be asked for it with hidden input.
DEMO_DATABASE_URL=
# Optional: password for all ten demo accounts when seeding (8-72 characters).
DEMO_PASSWORD=
